{
    "name": "clesson-de/silverstripe-interval",
    "description": "ISO-8601 interval field for SilverStripe 6 with user-friendly input and localized output formatting.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "interval",
        "date-interval",
        "iso-8601",
        "php-interval"
    ],
    "authors": [
        {
            "name": "Kai Feldmaier",
            "email": "kai.feldmaier@clesson.de",
            "homepage": "https://clesson.de"
        }
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.2",
        "silverstripe/framework": "^6"
    },
    "autoload": {
        "psr-4": {
            "Clesson\\Silverstripe\\Interval\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require-dev": {
        "clesson-de/silverstripe-codeguard": "^0.0.3"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
